rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // All records are private to users/{uid}; no email or profile fields are stored.
    // users/{uid}: uid string (required, immutable, authenticated UID),
    //   migratedFromLocal bool (optional; migration status only).
    // users/{uid}/tasks/{taskId}: title/category, priority, date, optional allDay/dueTime,
    //   up to 10 reminder datetimes, note, and done. Legacy remind enum is accepted during migration.
    // users/{uid}/courses/{courseId}: name string 1-120, day string 0-6,
    //   time/end HH:mm, room/teacher strings <=120, color/accent #RRGGBB.
    //   All fields required; courseId is generated by Firestore.
    // users/{uid}/categories/{categoryId}: name string 1-30, optional theme color #RRGGBB.
    // users/{uid}/preferences/main: taskReminders bool, taskLead enum,
    //   courseReminders bool, courseLead enum, quietHours bool (all required).
    // All subcollections are accessible only when request.auth.uid == {uid}.
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid'])
        && data.keys().hasOnly(['uid', 'migratedFromLocal'])
        && data.uid is string
        && data.uid.size() <= 128
        && data.uid == request.auth.uid
        && (!('migratedFromLocal' in data) || data.migratedFromLocal is bool);
    }

    function isValidTask(data) {
      return data.keys().hasAll(['title', 'category', 'priority', 'date', 'note', 'done'])
        && data.keys().hasOnly(['title', 'category', 'priority', 'date', 'remind', 'note', 'done', 'allDay', 'dueTime', 'reminders'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.category is string && data.category.size() > 0 && data.category.size() <= 30
        && data.priority in ['一般', '重要', '急迫']
        && data.date is string && data.date.size() <= 10
        && (data.date == '' || data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!('remind' in data) || data.remind in ['提前 1 天', '提前 2 小時', '提前 30 分鐘'])
        && (!('allDay' in data) || data.allDay is bool)
        && (!('dueTime' in data) || (data.dueTime is string && (data.dueTime == '' || data.dueTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))))
        && (!('allDay' in data) || data.allDay || (data.date != '' && 'dueTime' in data && data.dueTime is string && data.dueTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!('reminders' in data) || (data.reminders is list && data.reminders.size() <= 10))
        && data.note is string && data.note.size() <= 2000
        && data.done is bool;
    }

    function isValidCourse(data) {
      return data.keys().hasAll(['name', 'day', 'time', 'end', 'room', 'teacher', 'color', 'accent'])
        && data.keys().hasOnly(['name', 'day', 'time', 'end', 'room', 'teacher', 'color', 'accent'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.day in ['0', '1', '2', '3', '4', '5', '6']
        && data.time is string && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.end is string && data.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.room is string && data.room.size() <= 120
        && data.teacher is string && data.teacher.size() <= 120
        && data.color is string && data.color.matches('^#[0-9A-Fa-f]{6}$')
        && data.accent is string && data.accent.matches('^#[0-9A-Fa-f]{6}$');
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name'])
        && data.keys().hasOnly(['name', 'color'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 30
        && (!('color' in data) || (data.color is string && data.color.matches('^#[0-9A-Fa-f]{6}$')));
    }

    function isValidPreferences(data) {
      return data.keys().hasAll(['taskReminders', 'taskLead', 'courseReminders', 'courseLead', 'quietHours'])
        && data.keys().hasOnly(['taskReminders', 'taskLead', 'courseReminders', 'courseLead', 'quietHours'])
        && data.taskReminders is bool
        && data.taskLead in ['提前 1 天', '提前 2 小時', '提前 30 分鐘']
        && data.courseReminders is bool
        && data.courseLead in ['提前 30 分鐘', '提前 15 分鐘', '提前 5 分鐘']
        && data.quietHours is bool;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && uidUnchanged() && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && uidNotModified() && isValidUser(request.resource.data);
      allow delete: if false;

      match /tasks/{taskId} {
        allow read: if isOwner(userId) && userExists(userId);
        allow create: if isOwner(userId) && userExists(userId) && isValidTask(request.resource.data);
        allow update: if isOwner(userId) && userExists(userId) && isValidTask(request.resource.data);
        allow delete: if isOwner(userId) && userExists(userId) && isValidTask(resource.data);
      }

      match /courses/{courseId} {
        allow read: if isOwner(userId) && userExists(userId);
        allow create: if isOwner(userId) && userExists(userId) && isValidCourse(request.resource.data);
        allow update: if isOwner(userId) && userExists(userId) && isValidCourse(request.resource.data);
        allow delete: if isOwner(userId) && userExists(userId) && isValidCourse(resource.data);
      }

      match /categories/{categoryId} {
        allow read: if isOwner(userId) && userExists(userId);
        allow create: if isOwner(userId) && userExists(userId) && isValidCategory(request.resource.data);
        allow update: if isOwner(userId) && userExists(userId) && isValidCategory(request.resource.data);
        allow delete: if isOwner(userId) && userExists(userId) && isValidCategory(resource.data);
      }

      match /preferences/{preferenceId} {
        allow read: if isOwner(userId) && userExists(userId);
        allow create: if isOwner(userId) && userExists(userId) && preferenceId == 'main' && isValidPreferences(request.resource.data);
        allow update: if isOwner(userId) && userExists(userId) && preferenceId == 'main' && isValidPreferences(request.resource.data);
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
